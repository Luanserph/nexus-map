# Nexus Maps — Variáveis de Ambiente para Ingestão de Jogos (scripts/add-game)
# Copie este arquivo para ".env" e preencha suas chaves de API.

# Obrigatória para buscar metadados (título, estúdio, ano, gêneros e imagem base)
# Obtenha gratuitamente em: https://rawg.io/apidocs
RAWG_API_KEY=

# Opcional — usada para baixar capa (grid), banner (hero) e logo em alta resolução.
# Se omitida, o pipeline faz fallback automático para as imagens da RAWG.
# Obtenha em: https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# Opcional — Base URL para servir os tiles de mapa via CDN (ex: Cloudflare R2).
# Deixe vazio em desenvolvimento local ou na Vercel para usar o caminho relativo "/tiles/...".
# Exemplo R2: VITE_TILES_BASE_URL=https://tiles.nexusmaps.com
VITE_TILES_BASE_URL=
